# =============================================================================
# IoT Network Guard — Environment Configuration Template
# File: .env.example
# Copy to .env and supply actual deployment values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Supabase REST API Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL Session Pooler (Port 5432)
SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_POOLER_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_COLLECTOR_USER=iot_collector.<your-project-ref>
SUPABASE_COLLECTOR_PASSWORD=your-secure-collector-password
SUPABASE_SSLMODE=require

# Cloud Sync Worker Configuration
ENABLE_CLOUD_SYNC=true

# Local Collector Configuration
COLLECTOR_INTERFACE_INDEX=1
SERIAL_PORT=COM6
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
