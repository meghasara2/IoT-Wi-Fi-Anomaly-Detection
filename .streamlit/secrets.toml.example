# =============================================================================
# Streamlit Community Cloud — Secrets Configuration Template
# File: .streamlit/secrets.toml.example
# Copy into Streamlit Cloud App Settings -> Secrets (or local .streamlit/secrets.toml)
# NEVER commit the actual 'secrets.toml' to Git.
#
# IMPORTANT SECURITY NOTICE:
# The public dashboard requires ONLY the anonymous/public Supabase key.
# NEVER place the collector PostgreSQL password, service-role secret key,
# or database administrator credentials into Streamlit secrets.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# FORMAT 1: Nested [supabase] table (Recommended for Streamlit Cloud)
# ─────────────────────────────────────────────────────────────────────────────
[supabase]
url = "https://cwqumhtzeiqrfhlesksw.supabase.co"
key = "your-supabase-public-anon-key-here"

# ─────────────────────────────────────────────────────────────────────────────
# FORMAT 2: Flat top-level variables (Supported for backward compatibility)
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL = "https://cwqumhtzeiqrfhlesksw.supabase.co"
# SUPABASE_ANON_KEY = "your-supabase-public-anon-key-here"
